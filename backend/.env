# Ambiente local de desenvolvimento — Luditeca API
# NÃO commitar este ficheiro (já coberto pelo .gitignore raiz).

DATABASE_URL=postgresql://postgres:admin@localhost:5432/luditeca?schema=public

# Segredo do JWT (gerado com crypto.randomBytes(48).toString('hex')).
JWT_SECRET=6f5fadd64b005bed4ec368bdf1adaeab47b6defc089102338dc55dc17a7cace24f774a972551aab0c163ab6cb89068eb

# Servidor Fastify
PORT=3020
HOST=0.0.0.0

# CORS — origens permitidas pelo CMS Next em dev
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:8080

# Storage local (ficheiros em backend/storage/<bucket>/...)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
PUBLIC_MEDIA_BASE=http://localhost:3020/media

# Recuperação de senha (link de reset cai no log do servidor; em dev o token é devolvido).
PASSWORD_RESET_PUBLIC_BASE_URL=http://localhost:3000/reset-password
PASSWORD_RESET_TTL_MINUTES=60
PASSWORD_RESET_DEV_RETURN_TOKEN=true

# Mantém registo público desligado (boas práticas; ver Issue 20 do plano).
ENABLE_PUBLIC_REGISTER=false

# Telemetria HTTP: persiste pedidos com >=3000 ms (mínimo efetivo 500 ms).
TELEMETRY_SLOW_MS=3000
