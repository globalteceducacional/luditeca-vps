# Desenvolvimento local: Postgres na maquina; imagens em backend/storage/ (STORAGE_DRIVER=local).
# Futuro S3: alterar STORAGE_DRIVER=s3 no backend e apontar NEXT_PUBLIC_MEDIA_BASE_URL para CDN/proxy publico.
# Backend sem PORT no .env ouve na 3020 (ver backend/src/server.ts). Se usar PORT=4000, mude aqui tambem.
NEXT_PUBLIC_API_URL=http://localhost:3020
NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:3020/media

# Teste com MinIO/S3 no host (backend STORAGE_DRIVER=s3) — ver docs/feature/ARMAZENAMENTO-MIDIA.md
# NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:8080/media

# Stack Docker + Nginx na porta 8080 (rebuild apos alterar)
# NEXT_PUBLIC_API_URL=http://localhost:8080/api
# NEXT_PUBLIC_MEDIA_BASE_URL=http://localhost:8080/media
